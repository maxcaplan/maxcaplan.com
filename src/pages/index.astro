---
/** Portfolio landing page */

import "./styles.scss";

import { getWorkCollection } from "@/util/content/portfolio_items";
import { getProjectsCollection } from "@/util/content/portfolio_items";

import HeroLayout from "@/layouts/HeroLayout/index.astro";
import TableOfContents from "@/components/navigation/TableOfContents";
import HomeWorkSection from "@/patterns/home/section/Work";
import HomeProjectsSection from "@/patterns/home/section/Projects";
import HomeServicesSection from "@/patterns/home/section/Services";
import HomeContactSection from "@/patterns/home/section/Contact";

const work_items = await getWorkCollection();
const projects = await getProjectsCollection();
---

<HeroLayout>
  <div class="root-padding">
    <div class="home-side-nav container--full">
      <aside class="home-side-nav__menu">
        <TableOfContents
          headings={[
            { text: "Work", slug: "work" },
            { text: "Projects", slug: "projects" },
            { text: "Services", slug: "services" },
            { text: "Contact", slug: "contact" },
          ]}
          client:load
        />
      </aside>

      <div class="home-side-nav__body">
        <HomeWorkSection work={work_items} />

        <HomeProjectsSection projects={projects} client:idle />

        <HomeServicesSection client:idle />
      </div>
    </div>
  </div>

  <HomeContactSection />
</HeroLayout>
