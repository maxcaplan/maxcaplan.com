---
import { getWorkCollection } from "@/util/content/work.ts";
import { getProjectCollection } from "@/util/content/projects";

import HeroLayout from "@/layouts/HeroLayout/index.astro";
import HomeNav from "@/components/navigation/home/Nav/index.tsx";
import HomeProjectsSection from "@/components/display/home/ProjectsSection";
import HomeWorkSection from "@/components/display/home/WorkSection";
import HomeServicesSection from "@/components/display/home/ServicesSection";
import HomeContactSection from "@/components/display/home/ContactSection";

const work_items = await getWorkCollection();
const projects = await getProjectCollection();
---

<HeroLayout>
  <HomeNav>
    <HomeNav.Menu
      anchors={[
        { name: "Work", id: "work" },
        { name: "Projects", id: "projects" },
        { name: "Services", id: "services" },
        { name: "Contact", id: "contact" },
      ]}
      client:load
    />

    <HomeNav.Content>
      <HomeWorkSection work={work_items} />

      <HomeProjectsSection projects={projects} client:idle />

      <HomeServicesSection client:idle />
    </HomeNav.Content>
  </HomeNav>

  <HomeContactSection />
</HeroLayout>
