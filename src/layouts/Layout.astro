---
import BaseLayout, { type BaseLayoutProps } from "@/layouts/BaseLayout.astro";
import Header from "@/patterns/Header/index.tsx";
import Footer from "@/patterns/Footer/index.tsx";

export interface LayoutProps extends BaseLayoutProps {
  "main-content"?: boolean;
}

type Props = LayoutProps;

const { title, "main-content": main_content } = Astro.props;
---

<BaseLayout title={title}>
  <slot name="head" slot="head" />

  <slot name="before-header" />
  <Header />
  <slot name="after-header" />

  <main id={main_content !== false ? "main-content" : undefined} class="main">
    <slot />
  </main>

  <slot name="before-footer" />
  <Footer />
  <slot name="after-footer" />
</BaseLayout>
